# Precisa ser único no mundo — inclua um sufixo próprio.
state_bucket_name = "tc3-tfstate-oficina-SEUSUFIXO"

budget_alert_emails = ["voce@exemplo.com"]
budget_limit_usd    = "100"

# O GitHub emite o subject do token OIDC com IDs imutáveis, então a role precisa
# deles para aceitar a troca. Como obter:
#   gh api users/OWNER      --jq .id
#   gh api repos/OWNER/REPO --jq .id
#
# Os repos podem não ser todos do mesmo dono, por isso o owner_id acompanha cada
# entrada. São os que fazem deploy ou aplicam Terraform: a plataforma e os
# três serviços.
github_repositories = [
  { repo = "SUA_ORG/tc3-infra-k8s", owner_id = "000000000", repo_id = "0000000000" },
  { repo = "SUA_ORG/tc3-auth-lambda", owner_id = "000000000", repo_id = "0000000000" },
  { repo = "SUA_ORG/tech-challenge-fiap", owner_id = "000000000", repo_id = "0000000000" },
  { repo = "SUA_ORG/oficina-billing-service", owner_id = "000000000", repo_id = "0000000000" },
  { repo = "SUA_ORG/oficina-execution-service", owner_id = "000000000", repo_id = "0000000000" },
]
